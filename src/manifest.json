{
  "manifest_version": 3,
  "name": "Kanakku for Google Cloud",
  "short_name": "Kanakku",
  "version": "0.1.1",
  "description": "Price tags for your Google Cloud console — see resource costs from your own BigQuery billing export.",
  "permissions": ["sidePanel", "identity", "storage"],
  "host_permissions": [
    "https://console.cloud.google.com/*",
    "https://bigquery.googleapis.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "__OAUTH_CLIENT_ID__",
    "scopes": ["https://www.googleapis.com/auth/bigquery.readonly"]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Kanakku for Google Cloud",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
